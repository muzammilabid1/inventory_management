# Must match SESSION_SECRET in inventory-api/.env.
SESSION_SECRET=replace_with_the_same_secret_used_by_the_api
# Leave unset on Vercel: dashboard API calls use the same-origin /api rewrite.
# For local development, set this to http://localhost:4000.
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:4000
# Vercel only: backend deployment origin, for example https://inventory-api.vercel.app
# INVENTORY_API_ORIGIN=
