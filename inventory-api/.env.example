API_PORT=4000
# For hosted PostgreSQL, use its complete connection string here instead of the DATABASE_* fields below.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=inventory_management_db
DATABASE_USER=inventory_app
DATABASE_PASSWORD=replace_with_your_database_password
# Used by Drizzle migrations and Studio; use the PostgreSQL admin account.
DRIZZLE_DATABASE_USER=postgres
DRIZZLE_DATABASE_PASSWORD=replace_with_your_postgres_admin_password
# For separate DATABASE_* fields, set true if the host requires SSL.
# Leave unset when DATABASE_URL already contains sslmode=require.
# DATABASE_SSL=false
# Optional separate connection string used by Drizzle migration commands.
# DRIZZLE_DATABASE_URL=postgresql://migration-user:password@host:5432/database?sslmode=require
WEB_ORIGIN=http://localhost:3000
# Optional for local development; use a long random value for production.
SESSION_SECRET=replace_with_a_long_random_secret
GMAIL_USER=your-dedicated-sender@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
# Optional. Keep the address the same as GMAIL_USER unless Gmail has an authorized send-as alias.
EMAIL_FROM=Inventory Management <your-dedicated-sender@gmail.com>
