{
  "name": "inventory-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/run-migrations.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:studio": "drizzle-kit studio --config=drizzle.config.js --host=127.0.0.1"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mjml": "^5.4.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
